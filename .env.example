# GhostMail Production Environment Configuration

# Web & API Server Port
PORT=3000

# Direct Inbound SMTP Server Port (default: 2525)
# In production on a VPS, redirect port 25 -> 2525 with iptables or bind directly
SMTP_PORT=2525

# Primary Custom Domain for Disposable Inboxes
DOMAIN=psvrajesh.in

# Path to persistent store file (default: ./data/store.json)
# In Docker, mounted to /app/data/store.json
DATA_FILE=./data/store.json

# Node Environment
NODE_ENV=production
